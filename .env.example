# =============================================================================
# Cyber-Vault AI Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is NEVER committed to git — it stays on your machine only.
#
# To switch AI providers, just change AI_PROVIDER and set the matching key.
# No code changes needed — only edit this .env file.
# =============================================================================

# ── PROVIDER SELECTION ────────────────────────────────────────────────────────
# Options: gemini | openai | groq | anthropic
AI_PROVIDER=gemini

# ── MODEL NAME (optional override) ───────────────────────────────────────────
# Leave blank to use the provider default.
# Gemini defaults:   gemini-2.0-flash
# OpenAI defaults:   gpt-4o-mini
# Groq defaults:     llama3-8b-8192
# Anthropic defaults: claude-3-haiku-20240307
AI_MODEL=

# ── API KEYS (fill in the one matching AI_PROVIDER) ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
